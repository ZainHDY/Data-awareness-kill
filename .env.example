# Copy this file to .env and fill in real values before running.

PORT=3001

# Your deployed frontend's origin, e.g. https://yourdomain.com
# Leave as * only for local development.
FRONTEND_ORIGIN=*

# Long random string — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required for /api/admin/* routes to work at all.
ADMIN_API_KEY=

# Salt used to hash IPs before storing (abuse-tracking only, never raw IPs).
# Generate the same way as ADMIN_API_KEY.
IP_HASH_SALT=

# Optional — defaults to ./study.db next to server.js
DB_PATH=
